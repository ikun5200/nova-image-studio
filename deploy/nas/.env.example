# 复制为 .env 后按实际情况修改
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 数据路径（相对容器内 /app）
NOVA_TASK_DB=backend/data/nova-tasks.sqlite
NOVA_IMAGE_DIR=backend/data/nova-images

# ===== 必改 =====
# 加密供应商 / 插件 API Key 的主密钥。生成：openssl rand -base64 48
NOVA_SECRET_KEY=请替换为一段足够长的随机字符串

# 首次启动自动创建管理员（创建后建议删除这两行或在后台改密）
NOVA_ADMIN_USERNAME=admin
NOVA_ADMIN_PASSWORD=请替换为强密码

# 本服务的公网 / 局域网地址。视频插件需要上游能匿名访问 <此地址>/api/nova/plugin-media/...
# 例如：http://192.168.1.100:3000 或 https://nova.example.com
# 也可以登录管理员后台 → 站点设置 → 公开访问地址填写，后台设置优先且无需重启。
# 支持多个地址（逗号或换行分隔），请求会优先匹配同 Host；后台可一行填一个。
NOVA_PUBLIC_BASE_URL=http://192.168.1.100:3000

# ===== 常用可选项 =====
NOVA_TASK_CONCURRENCY=50
NOVA_TASK_TTL_HOURS=12
NOVA_MAX_QUEUE_SIZE=200
NOVA_RATE_LIMIT_WINDOW_MS=60000
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=20
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=20
NOVA_MAX_PENDING_TASKS_PER_IP=20
NOVA_MAX_PENDING_TASKS_PER_API_KEY=10
NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=30

# 提示词广场：1=常驻 2=私密 3=关闭
PROMPT_GALLERY_MODE=1
PROMPT_GALLERY_PASSWORD=8848

# 反向代理终止 HTTPS 时设为 true
# NOVA_COOKIE_SECURE=true

# 本地单用户模式（跳过登录、使用浏览器自带密钥）。NAS 多用户部署保持 false。
NOVA_AUTH_DISABLED=false
